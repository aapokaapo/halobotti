# Discord bot token (from Discord Developer Portal)
BOT_TOKEN=

# Azure app credentials for Halo authentication
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
REDIRECT_URI=

# Spartan refresh token obtained during initial authentication
AZURE_REFRESH_TOKEN=

# Wait times polling configuration
# How often (in seconds) to poll the Halo Infinite lobby WebSocket (default: 300)
WAIT_TIMES_POLL_INTERVAL=300
# How many days to retain historical wait time records (default: 30)
WAIT_TIMES_RETENTION_DAYS=30
